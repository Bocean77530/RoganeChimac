# Public browser configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Application URLs and restaurant defaults
APP_BASE_URL=http://localhost:8080
# Public canonical origin used by SEO metadata, robots.txt and sitemap.xml.
# Set this to the same public HTTPS URL as APP_BASE_URL in production.
PUBLIC_SITE_URL=http://localhost:8080

# PostgreSQL (local, Railway, Azure Database for PostgreSQL, or AWS RDS)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_MAX=10

# Stripe Sandbox secrets (server only)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
PAYMENTS_EXPECT_LIVEMODE=false

# Ordering controls
QUOTE_TTL_SECONDS=600
PENDING_ORDER_TTL_SECONDS=1860
TRACKING_TOKEN_PEPPER=replace-with-a-long-random-secret

# Protects menu mutations in /admin/menu (server only, use at least 24 random characters)
ADMIN_ACCESS_TOKEN=replace-with-a-long-random-admin-token
